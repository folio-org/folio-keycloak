ARG ALPINE_VERSION=3.21.2
ARG KEYCLOAK_VERSION=26.6.3
FROM alpine:$ALPINE_VERSION AS providers_jar_downloader

# Set the working directory
WORKDIR /tmp/keycloak-providers-jars

# FOLIO Keycloak plugins versions to download
ARG FOLIO_KEYCLOAK_PLUGIN_VERSION=26.6.1

# Bouncy Castle JAR versions to download
ARG BC_FIPS_VERSION=2.1.3
ARG BCTLS_FIPS_VERSION=2.1.24
ARG BCPKIX_FIPS_VERSION=2.1.12
ARG BCUTIL_FIPS_VERSION=2.1.7

ARG FOLIO_MAVEN_URL=https://repository.folio.org/repository/maven-releases
ARG BC_MAVEN_URL=https://repo1.maven.org/maven2/org/bouncycastle

# Download Bouncy Castle JAR files
RUN wget ${FOLIO_MAVEN_URL}/org/folio/authentication/keycloak-detect-folio-user/${FOLIO_KEYCLOAK_PLUGIN_VERSION}/keycloak-detect-folio-user-${FOLIO_KEYCLOAK_PLUGIN_VERSION}.jar \
 && wget ${FOLIO_MAVEN_URL}/org/folio/authentication/keycloak-ecs-folio-authenticator/${FOLIO_KEYCLOAK_PLUGIN_VERSION}/keycloak-ecs-folio-authenticator-${FOLIO_KEYCLOAK_PLUGIN_VERSION}.jar \
 && wget ${BC_MAVEN_URL}/bc-fips/${BC_FIPS_VERSION}/bc-fips-${BC_FIPS_VERSION}.jar \
 && wget ${BC_MAVEN_URL}/bctls-fips/${BCTLS_FIPS_VERSION}/bctls-fips-${BCTLS_FIPS_VERSION}.jar \
 && wget ${BC_MAVEN_URL}/bcpkix-fips/${BCPKIX_FIPS_VERSION}/bcpkix-fips-${BCPKIX_FIPS_VERSION}.jar \
 && wget ${BC_MAVEN_URL}/bcutil-fips/${BCUTIL_FIPS_VERSION}/bcutil-fips-${BCUTIL_FIPS_VERSION}.jar

ARG KEYCLOAK_VERSION
ARG KC_MAVEN_URL=https://repo1.maven.org/maven2/org/keycloak
RUN mkdir -p /tmp/kc-patch-src \
 && wget -O /tmp/kc-patch-src/keycloak-crypto-fips1402-${KEYCLOAK_VERSION}-sources.jar ${KC_MAVEN_URL}/keycloak-crypto-fips1402/${KEYCLOAK_VERSION}/keycloak-crypto-fips1402-${KEYCLOAK_VERSION}-sources.jar

FROM quay.io/keycloak/keycloak:${KEYCLOAK_VERSION} AS keycloak_dist

# Rebuild FIPS1402Provider so BCFIPS starts in HYBRID mode: a background entropy daemon
# feeds a SP 800-90A pool, so foreground crypto never blocks on live entropy gathering
# (EUREKASUP-168: entropy stalls wedge the JGroups-mTLS Infinispan cluster). The config
# string cannot be injected via java.security on the Quarkus distribution - provider jars
# in /opt/keycloak/providers are invisible to the JCA system classloader - so the
# constructor call is patched at the single site and the class rebuilt against the
# distribution's own jars. The grep guard fails the build if that site changes upstream.
FROM registry.access.redhat.com/ubi9/openjdk-21:latest AS fips_provider_patcher
USER root
ARG KEYCLOAK_VERSION
WORKDIR /tmp/patch
COPY --from=keycloak_dist /opt/keycloak/lib/lib/ lib/
COPY --from=providers_jar_downloader /tmp/keycloak-providers-jars/ providers/
COPY --from=providers_jar_downloader /tmp/kc-patch-src/ ./
RUN jar xf keycloak-crypto-fips1402-${KEYCLOAK_VERSION}-sources.jar org/keycloak/crypto/fips/FIPS1402Provider.java \
 && [ "$(grep -c 'new BouncyCastleFipsProvider()' org/keycloak/crypto/fips/FIPS1402Provider.java)" = "1" ] \
 && sed -i 's|new BouncyCastleFipsProvider()|new BouncyCastleFipsProvider("C:HYBRID;ENABLE{ALL};")|' org/keycloak/crypto/fips/FIPS1402Provider.java \
 && javac --release 17 -nowarn -cp "providers/*:lib/boot/*:lib/main/*" -d classes org/keycloak/crypto/fips/FIPS1402Provider.java \
 && cp lib/main/org.keycloak.keycloak-crypto-fips1402-${KEYCLOAK_VERSION}.jar patched-crypto-fips1402.jar \
 && jar uf patched-crypto-fips1402.jar -C classes org/keycloak/crypto/fips

FROM quay.io/keycloak/keycloak:${KEYCLOAK_VERSION} AS builder
ARG KEYCLOAK_VERSION

ENV KC_DB=postgres
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true
ENV KC_FEATURES=scripts:v1,token-exchange:v1,admin-fine-grained-authz:v1,fips:v1
ENV KC_FIPS_MODE=strict

COPY --chown=keycloak:keycloak --from=providers_jar_downloader /tmp/keycloak-providers-jars/ /opt/keycloak/providers/
COPY --chown=keycloak:keycloak libs/folio-scripts.jar /opt/keycloak/providers/
COPY --chown=keycloak:keycloak conf/* /opt/keycloak/conf/

COPY --from=fips_provider_patcher --chown=keycloak:keycloak /tmp/patch/patched-crypto-fips1402.jar /opt/keycloak/lib/lib/main/org.keycloak.keycloak-crypto-fips1402-${KEYCLOAK_VERSION}.jar

RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:${KEYCLOAK_VERSION}

COPY --from=builder --chown=keycloak:keycloak /opt/keycloak/ /opt/keycloak/

# Temporary setting required to retain Keycloak 26.5.7 OIDC behavior expected by FOLIO.
ENV KC_SPI_LOGIN_PROTOCOL__OPENID_CONNECT__ALLOW_TOKEN_INTROSPECTION_WITHOUT_AUDIENCE_CHECK=true
ENV KC_SPI_LOGIN_PROTOCOL__OPENID_CONNECT__ALLOW_USERINFO_WITH_LIGHTWEIGHT_ACCESS_TOKEN=true

RUN mkdir /opt/keycloak/bin/folio
COPY --chown=keycloak:keycloak folio/configure-realms.sh /opt/keycloak/bin/folio/configure-realms.sh
COPY --chown=keycloak:keycloak folio/setup-admin-client.sh /opt/keycloak/bin/folio/setup-admin-client.sh
COPY --chown=keycloak:keycloak folio/start-fips.sh /opt/keycloak/bin/folio/start-fips.sh
COPY --chown=keycloak:keycloak custom-theme /opt/keycloak/themes/custom-theme
COPY --chown=keycloak:keycloak custom-theme-sso-only /opt/keycloak/themes/custom-theme-sso-only
COPY --chown=keycloak:keycloak custom-theme-sso-first /opt/keycloak/themes/custom-theme-sso-first

USER root
RUN chmod -R 550 /opt/keycloak/bin/folio

USER keycloak

ENTRYPOINT ["/opt/keycloak/bin/folio/start-fips.sh"]
